# Copy this file to .env for local development.
# NEVER commit the real .env file. NEVER put real values in the README.

# Port the Express server listens on (Render sets this automatically)
PORT=3000

# Public base URL of the app.
# Local:  http://localhost:3000
# Render: https://your-app-name.onrender.com
APP_URL=http://localhost:3000

# GitHub OAuth App credentials (from https://github.com/settings/developers)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Secret used to sign the application JWT.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Set to "production" on Render so Secure cookies are enabled
NODE_ENV=development
